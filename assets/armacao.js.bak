(() => {
const cfg = window.RIGGING_CONFIG || {};
const el = {};
const fmt = new Intl.NumberFormat('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});
const df = new Intl.DateTimeFormat('pt-BR',{dateStyle:'short',timeStyle:'short'});
const state = {components:[],map:new Map(),projects:[],items:[],selected:null,drag:null,scale:Number(cfg.scalePxPerMeter||54),snap:Number(cfg.snapStepM||0.1),zCounter:1,camera:{yaw:-34,pitch:26,distance:28,auto:false},project:emptyProject()};
function emptyProject(){return{id:null,editor:'rigging',name:',createdAt:null,updatedAt:null,canvas:{widthM:Number(cfg.defaultCanvasWidthM||20),heightM:Number(cfg.defaultCanvasHeightM||12)},view:{showNames:true,showDimensions:true,showDepth:true}};}
document.addEventListener('DOMContentLoaded',()=>{if(!document.getElementById('riggingWorkspace'))return;cache();bind();init().catch(handleError);});
function cache(){['riggingCatalog','riggingWorkspace','riggingPreview','riggingProjectName','riggingCanvasWidth','riggingCanvasHeight','riggingToggleNames','riggingToggleDimensions','riggingWidthStat','riggingHeightStat','riggingDepthStat','riggingTotalItems','riggingNewBtn','riggingSaveBtn','riggingApplyCanvas','riggingProjectList','riggingStatus','riggingSelectionEmpty','riggingSelectionForm','riggingSelectedName','riggingSelectedWidth','riggingSelectedHeight','riggingSelectedDepth','riggingSelectedX','riggingSelectedY','riggingSelectedZ','riggingSelectedRotationX','riggingSelectedRotationY','riggingSelectedRotationZ','riggingSelectedColor','riggingDuplicateBtn','riggingDeleteBtn'].forEach(id=>el[id]=document.getElementById(id));}
function bind(){el.riggingCatalog.addEventListener('click',e=>{const b=e.target.closest('[data-component-id]');if(b)addComponent(b.dataset.componentId);});el.riggingWorkspace.addEventListener('pointerdown',down);window.addEventListener('pointermove',move);window.addEventListener('pointerup',()=>state.drag=null);el.riggingWorkspace.addEventListener('click',e=>{const n=e.target.closest('[data-item-id]');select(n?n.dataset.itemId:null);});el.riggingProjectList.addEventListener('click',e=>{const n=e.target.closest('[data-project-id]');if(n)openProject(n.dataset.projectId);});el.riggingProjectName.addEventListener('input',()=>state.project.name=el.riggingProjectName.value.trim());el.riggingNewBtn.addEventListener('click',()=>newProject(true));el.riggingSaveBtn.addEventListener('click',saveProject);el.riggingApplyCanvas.addEventListener('click',applyCanvas);el.riggingToggleNames.addEventListener('change',syncView);el.riggingToggleDimensions.addEventListener('change',syncView);['riggingSelectedWidth','riggingSelectedHeight','riggingSelectedDepth','riggingSelectedX','riggingSelectedY','riggingSelectedZ','riggingSelectedRotationX','riggingSelectedRotationY','riggingSelectedRotationZ','riggingSelectedColor'].forEach(id=>{el[id].addEventListener('input',()=>updateSelected(false));el[id].addEventListener('change',()=>updateSelected(true));el[id].addEventListener('blur',()=>updateSelected(true));});el.riggingDuplicateBtn.addEventListener('click',duplicateSelected);el.riggingDeleteBtn.addEventListener('click',deleteSelected);window.addEventListener('keydown',keys);}
async function init(){newProject(false);setStatus('Carregando componentes e projetos de armacao...','info');const [c,p]=await Promise.all([json(api('components')),json(api('projects'))]);state.components=(Array.isArray(c.components)?c.components:[]).map(cmp=>({...cmp,depthM:r(Number(cmp.depthM||inferDepth(cmp.widthM,cmp.heightM)),2)}));state.map=new Map(state.components.map(c=>[String(c.id),c]));state.projects=(Array.isArray(p.projects)?p.projects:[]).filter(pj=>String(pj.editor||')==='rigging');renderAll();const q=new URLSearchParams(location.search).get('project');if(q)await openProject(q);loop();setStatus('Editor 3D pronto. Use A para orbitar a estrutura.','success');}
function newProject(show){state.project=emptyProject();state.items=[];state.selected=null;state.drag=null;state.zCounter=1;syncInputs();renderAll();if(show)setStatus('Novo projeto de armacao criado.','info');}
function syncInputs(){el.riggingProjectName.value=state.project.name;el.riggingCanvasWidth.value=String(state.project.canvas.widthM).replace('.',',');el.riggingCanvasHeight.value=String(state.project.canvas.heightM).replace('.',',');el.riggingToggleNames.checked=!!state.project.view.showNames;el.riggingToggleDimensions.checked=!!state.project.view.showDimensions;}
function syncView(){state.project.view.showNames=el.riggingToggleNames.checked;state.project.view.showDimensions=el.riggingToggleDimensions.checked;renderWorkspace();renderPreview();}
function renderAll(){renderCatalog();renderWorkspace();renderSelection();renderProjects();renderPreview();renderStats();}
function renderCatalog(){el.riggingCatalog.innerHTML=';if(!state.components.length){el.riggingCatalog.innerHTML='<div class="empty-state">Nenhum componente encontrado.</div>';return;}const f=document.createDocumentFragment();state.components.forEach(c=>{const b=document.createElement('button');b.type='button';b.className='catalog-card';b.dataset.componentId=String(c.id);b.innerHTML=`<div class="catalog-thumb"><img src="${c.image}" alt="${esc(c.name)}"></div><div class="catalog-meta"><strong>${esc(c.name)}</strong><span>${esc(c.category||'Outros')}</span><span>X ${m(c.widthM)} | Y ${m(c.heightM)} | Z ${m(c.depthM)}</span><span class="muted-note">Clique para inserir na armacao 3D.</span></div>`;f.appendChild(b);});el.riggingCatalog.appendChild(f);}
function renderWorkspace(){const w=Math.max(360,state.project.canvas.widthM*state.scale),h=Math.max(320,state.project.canvas.heightM*state.scale);el.riggingWorkspace.style.width=`${w}px`;el.riggingWorkspace.style.height=`${h}px`;el.riggingWorkspace.innerHTML=';const f=document.createDocumentFragment();state.items.slice().sort((a,b)=>a.zIndex-b.zIndex).forEach(it=>{const n=document.createElement('button');n.type='button';n.className=`canvas-item rigging-item${it.id===state.selected?' is-selected':'}`;n.dataset.itemId=it.id;n.style.left=`${it.x*state.scale}px`;n.style.bottom=`${it.y*state.scale}px`;n.style.width=`${it.widthM*state.scale}px`;n.style.height=`${it.heightM*state.scale}px`;n.style.transform=`rotate(${it.rotationZDeg||0}deg)`;n.style.zIndex=String(it.zIndex);n.style.background=`linear-gradient(135deg, ${it.color} 0%, ${shade(it.color,1.18)} 100%)`;n.innerHTML=`${it.image?`<img class="rigging-item__image" src="${it.image}" alt="${esc(it.name)}">`:'}<span class="rigging-item__surface"></span><span class="rigging-item__axis" aria-hidden="true"></span>${state.project.view.showNames?`<span class="item-title">${esc(it.name)}</span>`:'}${state.project.view.showDimensions?`<span class="dimension-badge dimension-badge--width">${m(it.widthM)} x ${m(it.heightM)}</span>`:'}<span class="rigging-item__elevation">Z ${m(it.z)}</span>`;f.appendChild(n);});el.riggingWorkspace.appendChild(f);}
function renderProjects(){el.riggingProjectList.innerHTML=';if(!state.projects.length){el.riggingProjectList.innerHTML='<div class="empty-state">Nenhum projeto de armacao salvo.</div>';return;}const f=document.createDocumentFragment();state.projects.forEach(p=>{const s=p.stats||{};const b=document.createElement('button');b.type='button';b.className=`project-card${p.id===state.project.id?' is-active':'}`;b.dataset.projectId=String(p.id||');b.innerHTML=`<strong>${esc(p.name||'Projeto sem nome')}</strong><span>${esc(date(p.updatedAt))}</span><div class="project-card__meta"><span>${Number(p.itemCount||0)} pecas</span><span>X ${m(s.widthM||0)}</span><span>Y ${m(s.heightM||0)}</span><span>Z ${m(s.depthM||0)}</span></div>`;f.appendChild(b);});el.riggingProjectList.appendChild(f);}
function renderSelection(){const it=item();const has=!!it;el.riggingSelectionEmpty.hidden=has;el.riggingSelectionForm.hidden=!has;if(!it)return;el.riggingSelectedName.value=it.name;el.riggingSelectedWidth.value=inp(it.widthM);el.riggingSelectedHeight.value=inp(it.heightM);el.riggingSelectedDepth.value=inp(it.depthM);el.riggingSelectedX.value=inp(it.x);el.riggingSelectedY.value=inp(it.y);el.riggingSelectedZ.value=inp(it.z);el.riggingSelectedRotationX.value=String(it.rotationXDeg||0);el.riggingSelectedRotationY.value=String(it.rotationYDeg||0);el.riggingSelectedRotationZ.value=String(it.rotationZDeg||0);el.riggingSelectedColor.value=color(it.color);}
function renderStats(){const s=stats(state.items);el.riggingWidthStat.textContent=m(s.widthM);el.riggingHeightStat.textContent=m(s.heightM);el.riggingDepthStat.textContent=m(s.depthM);el.riggingTotalItems.textContent=String(state.items.length);}
function addComponent(id){const c=state.map.get(String(id));if(!c)return;const o=state.items.length*0.4;state.items.push(clamp({id:uid(),componentId:String(c.id),name:String(c.name),image:String(c.image||'),widthM:Number(c.widthM||1),heightM:Number(c.heightM||1),depthM:Number(c.depthM||inferDepth(c.widthM,c.heightM)),x:1+o,y:1+o,z:0,zIndex:state.zCounter++,rotationDeg:0,rotationXDeg:0,rotationYDeg:0,rotationZDeg:0,color:defaultColor(c.id)}));state.selected=state.items[state.items.length-1].id;renderAll();setStatus(`Componente ${c.name} adicionado na armacao.`,'success');}
function down(e){const n=e.target.closest('[data-item-id]');if(!n)return;select(n.dataset.itemId);const it=item();const p=point(e.clientX,e.clientY);state.drag={id:it.id,dx:p.x-it.x,dy:p.y-it.y};}
function move(e){if(!state.drag)return;const it=item();if(!it||it.id!==state.drag.id)return;const p=point(e.clientX,e.clientY);it.x=p.x-state.drag.dx;it.y=p.y-state.drag.dy;clampInPlace(it);renderWorkspace();renderPreview();renderSelection();renderStats();}
function select(id){state.selected=id;renderWorkspace();renderSelection();renderPreview();}
function item(){return state.items.find(i=>i.id===state.selected)||null;}
function updateSelected(syncForm){const it=item();if(!it)return;it.widthM=num(el.riggingSelectedWidth.value,it.widthM);it.heightM=num(el.riggingSelectedHeight.value,it.heightM);it.depthM=num(el.riggingSelectedDepth.value,it.depthM);it.x=num(el.riggingSelectedX.value,it.x);it.y=num(el.riggingSelectedY.value,it.y);it.z=num(el.riggingSelectedZ.value,it.z);it.rotationXDeg=rot(num(el.riggingSelectedRotationX.value,it.rotationXDeg));it.rotationYDeg=rot(num(el.riggingSelectedRotationY.value,it.rotationYDeg));it.rotationZDeg=rot(num(el.riggingSelectedRotationZ.value,it.rotationZDeg));it.rotationDeg=it.rotationZDeg;it.color=color(el.riggingSelectedColor.value);clampInPlace(it);renderWorkspace();renderPreview();if(syncForm)renderSelection();renderStats();}
function duplicateSelected(){const it=item();if(!it)return;state.items.push(clamp({...it,id:uid(),x:it.x+0.4,y:it.y+0.4,z:it.z+0.1,zIndex:state.zCounter++}));state.selected=state.items[state.items.length-1].id;renderAll();}
function deleteSelected(){const it=item();if(!it)return;state.items=state.items.filter(x=>x.id!==it.id);state.selected=null;renderAll();}
function applyCanvas(){state.project.canvas.widthM=cl(num(el.riggingCanvasWidth.value,state.project.canvas.widthM),2,200);state.project.canvas.heightM=cl(num(el.riggingCanvasHeight.value,state.project.canvas.heightM),2,200);state.items.forEach(clampInPlace);syncInputs();renderAll();}
async function saveProject(){const payload={id:state.project.id,editor:'rigging',name:state.project.name||el.riggingProjectName.value.trim()||'Projeto de armacao sem nome',createdAt:state.project.createdAt,canvas:state.project.canvas,view:state.project.view,items:state.items.map(i=>({...i,rotationDeg:i.rotationZDeg})),stats:stats(state.items)};setStatus('Salvando projeto de armacao...','info');const res=await json(api('save_project'),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});if(res.project)hydrate(res.project);const p=await json(api('projects'));state.projects=(Array.isArray(p.projects)?p.projects:[]).filter(pj=>String(pj.editor||')==='rigging');renderProjects();setStatus('Projeto de armacao salvo com sucesso.','success');}
async function openProject(id){setStatus('Abrindo projeto de armacao...','info');const res=await json(api('project',{id}));if(!res.project||String(res.project.editor||')!=='rigging')throw new Error('Esse projeto salvo pertence a outro editor.');hydrate(res.project);renderAll();setStatus(`Projeto ${res.project.name||'sem nome'} carregado.`,'success');}
function hydrate(p){state.project.id=p.id||null;state.project.name=String(p.name||');state.project.createdAt=p.createdAt||null;state.project.updatedAt=p.updatedAt||null;state.project.canvas.widthM=cl(num(p.canvas&&p.canvas.widthM,20),2,200);state.project.canvas.heightM=cl(num(p.canvas&&p.canvas.heightM,12),2,200);state.project.view={showNames:typeof p.view?.showNames==='boolean'?p.view.showNames:true,showDimensions:typeof p.view?.showDimensions==='boolean'?p.view.showDimensions:true,showDepth:typeof p.view?.showDepth==='boolean'?p.view.showDepth:true};state.items=(Array.isArray(p.items)?p.items:[]).map(i=>clamp({id:String(i.id||uid()),componentId:String(i.componentId||'),name:String(i.name||'Componente'),image:String(i.image||'),widthM:num(i.widthM,1),heightM:num(i.heightM,1),depthM:num(i.depthM,inferDepth(i.widthM,i.heightM)),x:num(i.x,0),y:num(i.y,0),z:cl(num(i.z,0),0,100),zIndex:Number(i.zIndex||1),rotationDeg:num(i.rotationDeg,0),rotationXDeg:num(i.rotationXDeg,0),rotationYDeg:num(i.rotationYDeg,0),rotationZDeg:num(i.rotationZDeg,i.rotationDeg),color:color(i.color||defaultColor(i.componentId))}));state.selected=state.items[0]?.id||null;state.zCounter=Math.max(1,...state.items.map(i=>Number(i.zIndex||1)))+1;syncInputs();}
function keys(e){if(document.body.dataset.page!=='armacao')return;const t=e.target;if(t&&['INPUT','TEXTAREA','SELECT'].includes(t.tagName))return;const it=item();if(e.key.toLowerCase()==='a'){state.camera.auto=!state.camera.auto;setStatus(state.camera.auto?'Orbita automatica ativada.':'Orbita automatica pausada.','info');renderPreview();e.preventDefault();return;}let changed=false;if(e.shiftKey&&it){if(e.key==='ArrowLeft'){it.x-=state.snap;changed=true;}else if(e.key==='ArrowRight'){it.x+=state.snap;changed=true;}else if(e.key==='ArrowUp'){it.y+=state.snap;changed=true;}else if(e.key==='ArrowDown'){it.y-=state.snap;changed=true;}}else{if(e.key==='ArrowLeft'){state.camera.yaw-=6;renderPreview();e.preventDefault();return;}if(e.key==='ArrowRight'){state.camera.yaw+=6;renderPreview();e.preventDefault();return;}if(e.key==='ArrowUp'){state.camera.pitch=cl(state.camera.pitch+3,-10,75);renderPreview();e.preventDefault();return;}if(e.key==='ArrowDown'){state.camera.pitch=cl(state.camera.pitch-3,-10,75);renderPreview();e.preventDefault();return;}}if(it){const k=e.key.toLowerCase();if(e.key==='PageUp'){it.z+=state.snap;changed=true;}else if(e.key==='PageDown'){it.z-=state.snap;changed=true;}else if(k==='q'){it.rotationZDeg-=5;changed=true;}else if(k==='e'){it.rotationZDeg+=5;changed=true;}else if(k==='r'){it.rotationXDeg+=5;changed=true;}else if(k==='f'){it.rotationXDeg-=5;changed=true;}else if(k==='t'){it.rotationYDeg+=5;changed=true;}else if(k==='g'){it.rotationYDeg-=5;changed=true;}else if(e.key==='['){it.depthM-=0.02;changed=true;}else if(e.key===']'){it.depthM+=0.02;changed=true;}}if(!changed)return;e.preventDefault();clampInPlace(it);renderWorkspace();renderSelection();renderPreview();renderStats();}
function loop(){let last=0;const tick=ts=>{const d=ts-last;last=ts;if(state.camera.auto&&d>0){state.camera.yaw+=d*0.02;renderPreview();}requestAnimationFrame(tick);};requestAnimationFrame(tick);}
function renderPreview(){const c=el.riggingPreview,rc=c.getBoundingClientRect(),w=Math.max(640,Math.round(rc.width||c.width)),h=Math.max(420,Math.round(rc.height||c.height));if(c.width!==w||c.height!==h){c.width=w;c.height=h;}drawScene(c);}
function drawScene(canvas){const x=canvas.getContext('2d'),w=canvas.width,h=canvas.height;if(!x)return;x.clearRect(0,0,w,h);const g=x.createLinearGradient(0,0,0,h);g.addColorStop(0,'#0f172a');g.addColorStop(1,'#1e293b');x.fillStyle=g;x.fillRect(0,0,w,h);grid(x,w,h);const s=stats(state.items),center={x:s.minX+s.widthM/2,y:s.minY+s.heightM/2,z:Math.max(0.5,s.depthM/2)},scale=Math.max(22,Math.min(w/Math.max(s.widthM+6,10),h/Math.max(s.heightM+s.depthM+8,10))*2.2),faces=[],labels=[];state.items.forEach(it=>{const meshes=buildMeshes(it);meshes.forEach(mesh=>{const verts=mesh.vertices.map(v=>screen(v,center,w,h,scale));mesh.faces.forEach(f=>{const pts=f.map(i=>verts[i]);faces.push({pts,depth:pts.reduce((a,p)=>a+p.d,0)/pts.length,fill:shade(it.color,mesh.shade||0.92),stroke:it.id===state.selected?'#f8fafc':'rgba(226,232,240,0.32)',lw:it.id===state.selected?2.2:1});});});labels.push({name:it.name,p:screen({x:it.x+it.widthM/2,y:it.y+it.heightM/2,z:it.z+it.depthM+0.12},center,w,h,scale)});});faces.sort((a,b)=>a.depth-b.depth).forEach(f=>{x.beginPath();f.pts.forEach((p,i)=>i?x.lineTo(p.x,p.y):x.moveTo(p.x,p.y));x.closePath();x.fillStyle=f.fill;x.fill();x.strokeStyle=f.stroke;x.lineWidth=f.lw;x.stroke();});if(state.project.view.showNames){x.font='600 12px Segoe UI';x.textAlign='center';labels.forEach(({name,p})=>{const mw=x.measureText(name).width+16;x.fillStyle='rgba(15,23,42,0.8)';x.fillRect(p.x-mw/2,p.y-20,mw,18);x.fillStyle='#f8fafc';x.fillText(name,p.x,p.y-7);});}if(state.project.view.showDimensions){x.fillStyle='rgba(226,232,240,0.9)';x.font='12px Segoe UI';x.textAlign='left';x.fillText(`Camera yaw ${Math.round(state.camera.yaw)}° | pitch ${Math.round(state.camera.pitch)}° | pecas ${state.items.length}`,18,26);x.fillText(`Estrutura ${m(s.widthM)} x ${m(s.heightM)} x ${m(s.depthM)}`,18,44);}}
function grid(x,w,h){x.strokeStyle='rgba(148,163,184,0.14)';for(let i=0;i<=w;i+=40){x.beginPath();x.moveTo(i,0);x.lineTo(i,h);x.stroke();}for(let j=0;j<=h;j+=40){x.beginPath();x.moveTo(0,j);x.lineTo(w,j);x.stroke();}x.strokeStyle='rgba(226,232,240,0.2)';x.beginPath();x.moveTo(0,h*0.7+.5);x.lineTo(w,h*0.7+.5);x.stroke();}
function buildMeshes(it){if(isStair(it)){return stairMeshes(it);}return[cuboid(it,0.92)];}
function isStair(it){const ref=`${String(it.componentId||'')} ${String(it.name||'')} ${String(it.image||'')}`.toLowerCase();return ref.includes('escada');}
function stairMeshes(it){const steps=Math.max(3,Math.min(6,Math.round(it.heightM/0.22)||4));const meshes=[];const stepHeight=it.heightM/steps;const stepWidth=it.widthM/steps;for(let i=0;i<steps;i+=1){const currentHeight=stepHeight*(i+1);meshes.push(cuboid({x:it.x+(stepWidth*i),y:it.y,z:it.z,widthM:stepWidth,heightM:currentHeight,depthM:it.depthM,rotationXDeg:it.rotationXDeg,rotationYDeg:it.rotationYDeg,rotationZDeg:it.rotationZDeg},0.82+(i/steps)*0.14));}return meshes;}
function cuboid(it,shadeFactor){const c={x:it.x+it.widthM/2,y:it.y+it.heightM/2,z:it.z+it.depthM/2};const v=[{x:it.x,y:it.y,z:it.z},{x:it.x+it.widthM,y:it.y,z:it.z},{x:it.x+it.widthM,y:it.y+it.heightM,z:it.z},{x:it.x,y:it.y+it.heightM,z:it.z},{x:it.x,y:it.y,z:it.z+it.depthM},{x:it.x+it.widthM,y:it.y,z:it.z+it.depthM},{x:it.x+it.widthM,y:it.y+it.heightM,z:it.z+it.depthM},{x:it.x,y:it.y+it.heightM,z:it.z+it.depthM}].map(p=>rot3(p,c,it.rotationXDeg,it.rotationYDeg,it.rotationZDeg));return{vertices:v,faces:[[0,1,2,3],[4,5,6,7],[0,1,5,4],[1,2,6,5],[2,3,7,6],[3,0,4,7]],shade:shadeFactor||0.92};}
function screen(p,c,w,h,scale){const yaw=rad(state.camera.yaw),pitch=rad(state.camera.pitch);const t={x:p.x-c.x,y:p.y-c.y,z:p.z-c.z};const a={x:t.x*Math.cos(yaw)-t.y*Math.sin(yaw),y:t.x*Math.sin(yaw)+t.y*Math.cos(yaw),z:t.z};const b={x:a.x,y:a.y*Math.cos(pitch)-a.z*Math.sin(pitch),z:a.y*Math.sin(pitch)+a.z*Math.cos(pitch)};const pers=Math.max(0.22,state.camera.distance/(state.camera.distance+b.y+18));return{x:w/2+b.x*scale*pers,y:h*0.7-b.z*scale*pers,d:b.y};}
function rot3(p,c,rx,ry,rz){let t={x:p.x-c.x,y:p.y-c.y,z:p.z-c.z};t=rotX(t,rad(rx));t=rotY(t,rad(ry));t=rotZ(t,rad(rz));return{x:t.x+c.x,y:t.y+c.y,z:t.z+c.z};}
function rotX(p,r){return{x:p.x,y:p.y*Math.cos(r)-p.z*Math.sin(r),z:p.y*Math.sin(r)+p.z*Math.cos(r)}}function rotY(p,r){return{x:p.x*Math.cos(r)+p.z*Math.sin(r),y:p.y,z:-p.x*Math.sin(r)+p.z*Math.cos(r)}}function rotZ(p,r){return{x:p.x*Math.cos(r)-p.y*Math.sin(r),y:p.x*Math.sin(r)+p.y*Math.cos(r),z:p.z}}
function stats(items){if(!items.length)return{minX:0,minY:0,minZ:0,maxX:0,maxY:0,maxZ:0,widthM:0,heightM:0,depthM:0};let minX=1/0,minY=1/0,minZ=1/0,maxX=-1/0,maxY=-1/0,maxZ=-1/0;items.forEach(i=>{minX=Math.min(minX,i.x);minY=Math.min(minY,i.y);minZ=Math.min(minZ,i.z);maxX=Math.max(maxX,i.x+i.widthM);maxY=Math.max(maxY,i.y+i.heightM);maxZ=Math.max(maxZ,i.z+i.depthM);});return{minX:r(minX,2),minY:r(minY,2),minZ:r(minZ,2),maxX:r(maxX,2),maxY:r(maxY,2),maxZ:r(maxZ,2),widthM:r(Math.max(0,maxX-minX),2),heightM:r(Math.max(0,maxY-minY),2),depthM:r(Math.max(0,maxZ-minZ),2)};}
function point(cx,cy){const rct=el.riggingWorkspace.getBoundingClientRect();return{x:r(cl(cx-rct.left,0,rct.width)/state.scale,4),y:r(cl(rct.bottom-cy,0,rct.height)/state.scale,4)};}
function clamp(obj){const n={...obj};clampInPlace(n);return n;}
function clampInPlace(i){i.widthM=r(cl(i.widthM,0.05,state.project.canvas.widthM),2);i.heightM=r(cl(i.heightM,0.05,state.project.canvas.heightM),2);i.depthM=r(cl(i.depthM,0.02,20),2);i.x=r(cl(snap(i.x),0,Math.max(0,state.project.canvas.widthM-i.widthM)),2);i.y=r(cl(snap(i.y),0,Math.max(0,state.project.canvas.heightM-i.heightM)),2);i.z=r(Math.max(0,i.z),2);i.rotationXDeg=rot(i.rotationXDeg||0);i.rotationYDeg=rot(i.rotationYDeg||0);i.rotationZDeg=rot(i.rotationZDeg||i.rotationDeg||0);i.rotationDeg=i.rotationZDeg;i.color=color(i.color||'#3F4B5B');}
function api(action,params={}){const u=new URL(cfg.apiBase||'api.php',location.href);u.searchParams.set('action',action);Object.entries(params).forEach(([k,v])=>u.searchParams.set(k,v));return u.toString();}
async function json(url,opt={}){const res=await fetch(url,opt);const payload=await res.json().catch(()=>({}));if(!res.ok)throw new Error(payload.error||'Falha na comunicacao com o servidor.');return payload;}
function handleError(err){console.error(err);setStatus(err.message||'Nao foi possivel iniciar o editor de armacao.','error');}
function setStatus(msg,tone){el.riggingStatus.textContent=msg;el.riggingStatus.className=`status-box status-box--${tone}`;}
function defaultColor(id){const s=String(id||').toLowerCase();if(s.includes('grid'))return'#2F3A48';if(s.includes('piso'))return'#C8A88F';if(s.includes('escada'))return'#A45C44';if(s.includes('fechamento'))return'#8D4A3A';return'#4C5E73';}
function inferDepth(w,h){return r(Math.max(0.02,Math.min(Math.min(Number(w||1),Number(h||1))*0.12,0.35)),2);}function uid(){return`rig_${Date.now()}_${Math.random().toString(16).slice(2,8)}`;}function num(v,f){const n=Number(String(v).replace(',','.'));return Number.isFinite(n)?n:f;}function cl(v,min,max){return Math.min(Math.max(v,min),max);}function r(v,d){const f=10**d;return Math.round((Number(v||0)+Number.EPSILON)*f)/f;}function rad(v){return Number(v||0)*Math.PI/180;}function snap(v){return r(Math.round(v/state.snap)*state.snap,2);}function rot(v){return r((((Number(v||0)%360)+360)%360),2);}function color(v){const s=String(v||').trim().toUpperCase();return/^#[0-9A-F]{6}$/.test(s)?s:'#3F4B5B';}function shade(c,f){const h=color(c).slice(1),rr=cl(Math.round(parseInt(h.slice(0,2),16)*f),0,255),gg=cl(Math.round(parseInt(h.slice(2,4),16)*f),0,255),bb=cl(Math.round(parseInt(h.slice(4,6),16)*f),0,255);return`rgb(${rr}, ${gg}, ${bb})`;}function m(v){return`${fmt.format(Number(v||0))} m`;}function inp(v){return String(r(v,2));}function date(v){const d=new Date(v||');return Number.isNaN(d.getTime())?'Data indisponivel':`Atualizado ${df.format(d)}`;}function esc(v){return String(v).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#39;');}
})();








